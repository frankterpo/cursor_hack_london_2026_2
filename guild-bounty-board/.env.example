# Copy values into Vercel → Project → Settings → Environment Variables (no trailing slash on URLs).

# --- Supabase (submissions, judges, repo analysis) — see `docs/TENANCY.md` ---
# SUPABASE_PROJECT_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_SECRET=
# Row UUID in `public.hackathons` to scope this deployment.
# Cursor × Thrads — London 2026:
DEFAULT_HACKATHON_ID=a0000003-0000-4000-8000-000000000003
# Briefcase London 2026: a0000002-0000-4000-8000-000000000002
# Legacy HCMC seed: a0000001-0000-4000-8000-000000000001

# Gate for /admin and /judge HTML (guild static). Vercel UI may show lowercase; these names are read:
# SITE_PASSWORD, site_password, or Site_Password
SITE_PASSWORD=

# HMAC signing secret for judge/admin board auth cookies (recommended in production).
# If omitted, a secret is derived from SITE_PASSWORD — rotate SITE_PASSWORD after any leak.
AUTH_SECRET=

# Credits portal admin (/credits/admin) — separate from SITE_PASSWORD when possible.
# ADMIN_PASSWORD=

# Static board → Next credits app (same team: use your credits deployment origin, no trailing slash).
# Thrads credits Next deployment (public): https://cursor-thrads-london-2026.vercel.app
CREDITS_APP_URL=

# --- Repo analysis (manager table + POST /api/reanalyze) ---
# GitHub REST API: fine-grained PAT or classic token with repo read access.
# Any of these names is accepted by the server:
# GITHUB_TOKEN=
# GITHUB_PAT=
# GH_TOKEN=
# OpenCode Zen (AI bullet summary after GitHub metrics):
# OPENCODE_API_KEY=
