# Cursor Credits portal (Next.js) — copy to `.env.local` in this directory.
# Main hack board + judge APIs use separate vars; see `../.env.example`.

# Required for `/submit`, `/judge`, `/manager` iframes: absolute guild board origin (trailing slash optional).
# NEXT_PUBLIC_BOARD_URL=https://your-guild-board.vercel.app

# Firestore `projects.slug` for this deploy’s codes + attendees batch (canonical redemption is always `/redeem`).
NEXT_PUBLIC_CREDITS_FIRESTORE_PROJECT_SLUG=cursor-thrads-london-2026

# Hackathon landing (`/hackathon`) — optional structured blob overrides the individual lines below:
# NEXT_PUBLIC_HACKATHON_LANDING_JSON={"title":"Cursor × Partner","subtitle":"London · 2026","tracks":["Track A"],"judges":[{"name":"Judge"}],"prizes":["Top prize"],"partnerLinks":[{"label":"Partner","href":"https://example.com"}]}
# NEXT_PUBLIC_HACKATHON_TITLE=
# NEXT_PUBLIC_HACKATHON_SUBTITLE=
# NEXT_PUBLIC_HACKATHON_TRACKS=Track one\nTrack two
# NEXT_PUBLIC_HACKATHON_JUDGES=Name One\nName Two
# NEXT_PUBLIC_HACKATHON_PRIZES=Prize A\nPrize B
# NEXT_PUBLIC_HACKATHON_JUDGES_JSON=[{"name":"Judge One","title":"Role"}]
# NEXT_PUBLIC_HACKATHON_PARTNER_LINKS_JSON=[{"label":"thrad.ai","href":"https://thrad.ai"}]

# Optional: same Supabase as guild-bounty-board API — enables live submissions + judge snapshot on /credits
# SUPABASE_PROJECT_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_SECRET=your-service-role-key
# Must match the event row in public.hackathons (see ../docs/TENANCY.md).
# Thrads London 2026: a0000003-…  |  Briefcase London: a0000002-…
DEFAULT_HACKATHON_ID=a0000003-0000-4000-8000-000000000003

# Firebase Configuration
# Copy this file to .env.local and fill in your Firebase project values

# Get these values from Firebase Console > Project Settings > General > Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Admin Dashboard Access (/credits/admin). If unset, falls back to SITE_PASSWORD / site_password.
ADMIN_PASSWORD=your_secure_admin_password_here

# Optional: same value as guild static gate (for one-password setups)
# SITE_PASSWORD=
# site_password=

