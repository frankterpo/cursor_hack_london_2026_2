rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deny direct client access. All reads/writes must go through Next.js API routes
    // using Firebase Admin SDK (bypasses rules). Do NOT deploy these rules until server
    // routes are migrated off the client Firestore SDK — see credits-portal README ops notes.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
